generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  blogs     Blog[]
  createdAt DateTime @default(now())
}

model Blog {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  content     String
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  categories  Category[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  blogs Blog[]
}